{
  "name": "typescript-template",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra"
  ],
  "type": "module",
  "scripts": {
    "check": "vp check --deny-warnings && ./node_modules/.bin/supdoc check --deny-warnings",
    "fix": "vp check --fix",
    "alchemy": "ALCHEMY_TELEMETRY_DISABLED=1 alchemy",
    "test": "bun test tools/lint && vp test",
    "prepare": "vp config --no-agent && bun tools/supdoc/install.ts",
    "build": "vp run -r build"
  },
  "dependencies": {
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@effect/platform-bun": "4.1.2",
    "@effect/platform-node": "4.1.2",
    "@effect/vitest": "4.1.2",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "alchemy": "2.0.0-beta.85",
    "typescript": "7.0.2",
    "ultracite": "8.1.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plus": "1.5.0"
  },
  "overrides": {
    "@effect/sql-d1": "4.1.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0"
  },
  "packageManager": "bun@1.4.3"
}
