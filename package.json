{
  "name": "typescript-template",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra"
  ],
  "type": "module",
  "scripts": {
    "audit": "bun tools/advisories/audit.ts",
    "renovate:validate": "bunx --package renovate@44.222.4 renovate-config-validator renovate.json",
    "check": "bun tools/hooks/present.ts && vp check --deny-warnings && ./node_modules/.bin/supdoc check --deny-warnings && bun run ui:typecheck && bun run db:check && bun tools/docs/runbook-check.ts docs/spin-up.md",
    "db:check": "bun tools/db/check.ts",
    "ui": "cd packages/ui && bunx shadcn@4.23.0",
    "ui:typecheck": "bun run --filter @workspace/ui typecheck",
    "fix": "vp check --fix",
    "footprint": "bun tools/blocks/footprint.ts",
    "knob": "bun tools/knob/knob.ts",
    "log-key": "bun tools/log-key/log-key.ts",
    "mirrors": "bun tools/mirrors/mirror.ts",
    "alchemy": "ALCHEMY_TELEMETRY_DISABLED=1 alchemy",
    "settings": "ALCHEMY_TELEMETRY_DISABLED=1 bun infra/stacks/settings.ts",
    "test": "bun test .test.mjs && vp test --project '!e2e-local'",
    "test:browser": "vp test --config vite.browser.config.ts",
    "test:cloud": "ALCHEMY_TEST_STAGE=test-ci vp test --config vite.cloud.config.ts",
    "db:regenerate": "git clean -fdq apps/api/migrations && bun run db:generate",
    "db:generate": "cd apps/api && ../../node_modules/.bin/drizzle-kit generate && bun ./scripts/migrations-digest.ts && cd ../auth && ../../node_modules/.bin/drizzle-kit generate",
    "pullout": "bun tools/blocks/pullout.ts",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config --local core.hooksPath .vite-hooks || true; effect-tsgo patch --oxlint",
    "build": "vp run -F '@workspace/*' build && bun tools/bundle/check.ts"
  },
  "dependencies": {
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@alchemy.run/github": "2.0.0-beta.85",
    "@distilled.cloud/cloudflare": "1.0.0-rc.18",
    "@effect/platform-bun": "4.1.2",
    "@effect/platform-node": "4.1.2",
    "@effect/tsgo": "0.67.7",
    "@effect/vitest": "4.1.2",
    "@oxlint/plugins": "1.91.0",
    "@shadcn/lint": "0.2.5",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@vitest/browser-playwright": "5.1.0",
    "alchemy": "2.0.0-beta.85",
    "axe-core": "4.14.0",
    "drizzle-kit": "1.0.0-rc.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "oxlint-plugin-react-doctor": "0.9.18",
    "playwright": "1.65.0",
    "supdoc": "0.6.0",
    "typescript": "7.0.2",
    "ultracite": "8.1.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plus": "1.5.0"
  },
  "overrides": {
    "@effect/sql-d1": "4.1.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "workerd": "1.20261026.1"
  },
  "packageManager": "bun@1.4.3"
}
