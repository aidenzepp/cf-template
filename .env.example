# Local values for `bun run alchemy dev`. Copy to `.env` (ignored) or inject them with any secret
# manager; see docs/spin-up.md. Never commit a filled-in copy.

# Optional OAuth pairs: leave a pair empty to hide that provider's button.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Override the derived stack name (a-z, 0-9, hyphens, at most 29 characters).
# STACK_NAME=
