{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["bun", "node"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": false,
        "allowedUnstableApis": [
          "@effect/vitest",
          "@effect/atom-react/Hooks",
          "@effect/atom-react/ReactHydration",
          "@effect/atom-react/RegistryContext",
          "@effect/platform-bun/BunFileSystem",
          "@effect/platform-bun/BunPath",
          "@effect/platform-bun/BunRuntime",
          "@effect/platform-bun/BunServices",
          "@effect/platform-node/NodeServices",
          "@effect/sql-d1/D1Client",
          "effect/ByteSize",
          "effect/ErrorReporter",
          "effect/FileSystem",
          "effect/Path",
          "effect/Stdio",
          "effect/crypto/Digest",
          // effect/crypto/Mac: email-key.ts signs email keys with HMAC; Effect has no stable Mac. unstable on purpose: this template builds on Effect v4 and other pre-1.0 APIs; the allowlist tracks the cost and a Renovate upgrade that breaks one shows in its pull request.
          "effect/crypto/Mac",
          // effect/crypto/SecureRandom: email-key.ts draws key bytes from it; no stable equivalent.
          "effect/crypto/SecureRandom",
          "effect/encoding/Jsonc",
          "effect/http-api/HttpApi",
          "effect/http-api/HttpApiBuilder",
          "effect/http-api/HttpApiEndpoint",
          "effect/http-api/HttpApiError",
          "effect/http-api/HttpApiGroup",
          "effect/http-api/HttpApiMiddleware",
          "effect/http-api/HttpApiScalar",
          "effect/http-api/HttpApiSchema",
          "effect/http-api/HttpApiTest",
          "effect/http-api/OpenApi",
          // effect/http/Cookies: the cloud notes test reads session cookies through it.
          "effect/http/Cookies",
          "effect/http/FetchHttpClient",
          // effect/http/Headers: the session middleware reads request headers through it.
          "effect/http/Headers",
          "effect/http/HttpClient",
          "effect/http/HttpClientRequest",
          "effect/http/HttpClientResponse",
          "effect/http/HttpEffect",
          "effect/http/HttpMethod",
          "effect/http/HttpRouter",
          "effect/http/HttpServer",
          "effect/http/HttpServerRequest",
          "effect/http/HttpServerResponse",
          "effect/http/ProblemDetails",
          "effect/http/Url",
          "effect/process/ChildProcess",
          "effect/process/ChildProcessSpawner",
          "effect/reactivity/AsyncResult",
          "effect/reactivity/Atom",
          "effect/reactivity/AtomHttpApi",
          "effect/reactivity/AtomRegistry",
          "effect/reactivity/Hydration",
          // effect/rpc/Rpc: the API session middleware and its test build RPCs on the unstable rpc modules (Rpc, RpcGroup, RpcMiddleware, RpcTest).
          "effect/rpc/Rpc",
          "effect/rpc/RpcGroup",
          "effect/rpc/RpcMiddleware",
          "effect/rpc/RpcTest",
          "effect/sql/SqlError"
        ]
      }
    ]
  }
}
