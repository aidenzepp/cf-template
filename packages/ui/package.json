{
  "name": "@workspace/ui",
  "private": true,
  "description": "Owns every file the shadcn CLI writes from the shadcn base registry. Must not own a first-party component, a hand edit under src, or a route.",
  "type": "module",
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./globals.css": "./src/styles/globals.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource-variable/roboto-slab": "5.3.0",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.2",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.71.0",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.21.0",
    "recharts": "3.8.0",
    "shadcn": "4.23.0",
    "sonner": "2.0.8",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
