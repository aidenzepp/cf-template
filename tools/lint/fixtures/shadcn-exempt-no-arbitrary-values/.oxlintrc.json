{
  "jsPlugins": [
    {
      "name": "shadcn",
      "specifier": "@shadcn/lint"
    }
  ],
  "rules": {
    "shadcn/no-arbitrary-values": [
      "error",
      {
        "allow": [
          "layout"
        ]
      }
    ]
  },
  "settings": {
    "shadcn": {
      "ui": [
        "@workspace/ui/components",
        "apps/web/src/styles/app.css"
      ]
    }
  },
  "overrides": [
    {
      "files": [
        "**/components/ui/**"
      ],
      "rules": {
        "shadcn/no-arbitrary-values": "off"
      }
    }
  ]
}
