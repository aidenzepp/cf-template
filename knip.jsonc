{
  "treatConfigHintsAsErrors": true,
  "includeEntryExports": true,
  "workspaces": {
    ".": {
      "vite": { "config": ["vite.config.ts", "vite.browser.config.ts", "vite.cloud.config.ts"] },
      "vitest": { "config": ["vite.config.ts", "vite.browser.config.ts", "vite.cloud.config.ts"] },
      "project": ["**/*.{ts,tsx,mjs}", "!.agents/**", "!test/browser/fixtures/**"],
    },
    "apps/auth": { "entry": ["auth.config.ts"] },
    "apps/web": {
      "entry": ["src/blocks.ts", "src/routes/-harness-*.tsx"],
      // Generated by TanStack Router.
      "ignore": ["src/route-tree.gen.ts"],
    },
    "infra": { "includeEntryExports": false },
    "tools": {
      "entry": ["**/*.test.{ts,mjs}", "lint/plugin.mjs"],
      "includeEntryExports": false,
      "project": [
        "**/*.{ts,tsx,mjs}",
        "!lint/fixtures/**",
        "!ratchet/fixtures/**",
        "!knob/alchemy.fixture.ts",
      ],
    },
    "packages/ui": { "entry": ["src/**/*.{ts,tsx}"], "includeEntryExports": false },
  },
}
