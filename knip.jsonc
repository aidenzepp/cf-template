{
  "treatConfigHintsAsErrors": true,
  "includeEntryExports": true,
  "workspaces": {
    ".": {
      "vite": { "config": ["vite.config.ts", "vite.browser.config.ts", "vite.cloud.config.ts"] },
      "vitest": { "config": ["vite.config.ts", "vite.browser.config.ts", "vite.cloud.config.ts"] },
      "project": [
        "**/*.{ts,tsx,mjs}",
        "!tools/lint/fixtures/**",
        "!tools/knob/alchemy.fixture.ts",
        "!test/browser/fixtures/**",
      ],
    },
    "apps/api": { "entry": ["scripts/*.ts"] },
    "apps/auth": { "entry": ["auth.config.ts"] },
    "apps/web": { "entry": ["src/blocks.ts", "src/routes/-harness-*.tsx"] },
    "infra": { "entry": ["scripts/*.ts"] },
    "packages/ui": { "entry": ["src/**/*.{ts,tsx}"], "includeEntryExports": false },
  },
}
